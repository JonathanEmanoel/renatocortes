generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Identidade local vinculada ao Supabase Auth.
/// `role` dirige roteamento e permissao; `deletedAt` oculta a conta sem apagar o usuario externo.
model User {
  id            String         @id @default(uuid())
  authId        String         @unique @map("auth_id")
  name          String
  email         String         @unique
  phone         String?
  role          UserRole
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  addresses     Address[]
  barber        Barber?
  client        Client?
  notifications Notification[]
  auditLogs     AuditLog[]
  expensesCreated Expense[]      @relation("ExpenseCreatedBy")
  expensesUpdated Expense[]      @relation("ExpenseUpdatedBy")
  manualServicesCreated ManualService[] @relation("ManualServiceCreatedBy")
  manualServiceChangeRequests ManualServiceChangeRequest[] @relation("ManualServiceChangeRequestedBy")
  manualServiceChangeDecisions ManualServiceChangeRequest[] @relation("ManualServiceChangeDecidedBy")
  subscriptionPayoutsPaid SubscriptionPayout[] @relation("SubscriptionPayoutPaidBy")

  @@index([email])
  @@index([role])
  @@map("users")
}

/// Perfil de cliente usado por agendamentos, loja e assinaturas.
/// Dados pessoais ficam em User; aqui ficam vinculos operacionais e notas internas.
model Client {
  id            String         @id @default(uuid())
  userId        String         @unique
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  appointments  Appointment[]
  manualServices ManualService[]
  reviews       Review[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      Payment[]
  sales         Sale[]
  subscriptions Subscription[]

  @@index([userId])
  @@map("clients")
}

/// Profissional que atende agenda, vendas presenciais e repasses.
/// Percentuais existem no cadastro, mas as regras atuais usam constantes centrais para evitar divergencia.
model Barber {
  id                       String               @id @default(uuid())
  userId                   String               @unique
  specialty                String?
  photo                    String?
  active                   Boolean              @default(true)
  serviceCommissionPercent Decimal              @default(50.00) @db.Decimal(5, 2)
  productCommissionPercent Decimal              @default(0.00) @db.Decimal(5, 2)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?
  appointments             Appointment[]
  availability             BarberAvailability[]
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions              EmployeeCommission[]
  reviews                  Review[]
  sales                    Sale[]
  manualServices           ManualService[]
  subscriptionPayouts       SubscriptionPayout[]

  @@index([userId])
  @@index([active])
  @@map("barbers")
}

/// Servico vendido como agendamento, avulso ou cobertura de plano.
/// Preco/duracao podem ser copiados para tabelas de itens para preservar historico.
model Service {
  id                       String                    @id @default(uuid())
  name                     String                    @unique
  description              String?
  duration                 Int
  price                    Decimal                   @db.Decimal(10, 2)
  active                   Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  appointments             Appointment[]
  appointmentServices      AppointmentService[]
  subscriptionPlanServices SubscriptionPlanService[]
  manualServiceItems       ManualServiceItem[]

  @@index([active])
  @@map("services")
}

/// Agendamento feito pelo cliente no site para um barbeiro e horario especifico.
/// So deve virar receita/comissao depois de finalizado conforme as regras do servidor.
model Appointment {
  id          String               @id @default(uuid())
  clientId    String
  barberId    String
  serviceId   String
  dataHora    DateTime
  status      AppointmentStatus    @default(PENDING)
  observacoes String?
  financialSnapshot Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  barber      Barber               @relation(fields: [barberId], references: [id])
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service     Service              @relation(fields: [serviceId], references: [id])
  services    AppointmentService[]
  commissions EmployeeCommission[]
  payments    Payment[]
  review      Review?

  @@index([clientId])
  @@index([barberId])
  @@index([serviceId])
  @@index([dataHora])
  @@index([status])
  @@map("appointments")
}

/// Snapshot dos serviços escolhidos dentro de uma unica visita agendada.
/// Permite Corte + Barba como um agendamento sem perder preco e duracao do momento.
model AppointmentService {
  id            String      @id @default(uuid())
  appointmentId String
  serviceId     String
  price         Decimal     @db.Decimal(10, 2)
  duration      Int
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
  @@index([appointmentId])
  @@index([serviceId])
  @@map("appointment_services")
}

/// Plano comercial de assinatura.
/// `value` e a base recorrente usada pelos relatorios enquanto assinaturas vinculadas estiverem ativas.
model SubscriptionPlan {
  id            String                    @id @default(uuid())
  name          String                    @unique
  description   String?
  value         Decimal                   @db.Decimal(10, 2)
  benefits      Json?
  cutsIncluded  Int?
  periodDays    Int                       @default(30)
  active        Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  deletedAt     DateTime?
  services      SubscriptionPlanService[]
  subscriptions Subscription[]

  @@index([active])
  @@map("subscription_plans")
}

/// Relacao entre plano e servicos cobertos.
/// A cobertura decide se um atendimento de assinante entra como R$0 avulso e visita para rateio.
model SubscriptionPlanService {
  id                 String           @id @default(uuid())
  subscriptionPlanId String
  serviceId          String
  service            Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPlanId, serviceId])
  @@index([serviceId])
  @@map("subscription_plan_services")
}

/// Assinatura contratada pelo cliente.
/// Status pendente/recusado nao deve gerar receita; apenas assinatura ativa entra nas regras financeiras.
model Subscription {
  id                 String           @id @default(uuid())
  clientId           String
  subscriptionPlanId String
  startDate          DateTime
  endDate            DateTime?
  active             Boolean          @default(true)
  status             SubscriptionStatus @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  payments           Payment[]
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  manualServices     ManualService[]

  @@index([clientId])
  @@index([subscriptionPlanId])
  @@index([active])
  @@map("subscriptions")
}

/// Categoria de produtos da loja/estoque.
model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  products  Product[]

  @@index([active])
  @@map("categories")
}

/// Produto de estoque vendido online ou presencialmente.
/// `visibleInStore` separa produtos publicos que geram comissao de itens internos consumidos no balcao.
model Product {
  id             String          @id @default(uuid())
  categoryId     String
  name           String          @unique
  description    String?
  price          Decimal         @db.Decimal(10, 2)
  costPrice      Decimal         @default(0.00) @db.Decimal(10, 2)
  stock          Int             @default(0)
  image          String?
  active         Boolean         @default(true)
  visibleInStore Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  category       Category        @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

/// Historico de entrada, ajuste, venda e retorno de estoque.
model StockMovement {
  id        String            @id @default(uuid())
  productId String
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@map("stock_movements")
}

/// Venda de produto da loja ou presencial.
/// `barberId` preenchido identifica venda presencial/comissionavel; sem barbeiro representa pedido online.
model Sale {
  id          String               @id @default(uuid())
  clientId    String?
  barberId    String?
  status      SaleStatus           @default(OPEN)
  totalValue  Decimal              @db.Decimal(10, 2)
  customerName  String?
  customerPhone String?
  deliveryMethod String?
  deliveryAddress Json?
  observations String?
  completedAt DateTime?
  canceledAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  commissions EmployeeCommission[]
  payments    Payment[]
  items       SaleItem[]
  barber      Barber?              @relation(fields: [barberId], references: [id], onDelete: SetNull)
  client      Client?              @relation(fields: [clientId], references: [id])

  @@index([barberId])
  @@index([clientId])
  @@index([status])
  @@map("sales")
}

/// Item vendido com snapshot de preco e custo.
/// A comissao de produto usa estes valores, nao o cadastro atual do produto.
model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  costPrice Decimal @default(0.00) @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

/// Registro de tentativa ou confirmacao de pagamento.
/// Apenas status pago com transacao financeira vinculada deve representar caixa efetivo.
model Payment {
  id             String                 @id @default(uuid())
  clientId       String?
  saleId         String?
  appointmentId  String?
  subscriptionId String?
  method         PaymentMethod
  status         PaymentStatus          @default(PENDING)
  amount         Decimal                @db.Decimal(10, 2)
  paidAt         DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  deletedAt      DateTime?
  transactions   FinancialTransaction[]
  appointment    Appointment?           @relation(fields: [appointmentId], references: [id])
  client         Client?                @relation(fields: [clientId], references: [id])
  sale           Sale?                  @relation(fields: [saleId], references: [id])
  subscription   Subscription?          @relation(fields: [subscriptionId], references: [id])

  @@index([clientId])
  @@index([saleId])
  @@index([appointmentId])
  @@index([subscriptionId])
  @@index([status])
  @@map("payments")
}

/// Categoria administrativa de despesa.
model ExpenseCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  expenses  Expense[]

  @@index([active])
  @@map("expense_categories")
}

/// Despesa operacional da barbearia.
/// Barbeiros podem solicitar despesas por fluxo separado; aqui ficam registros aprovados/administrativos.
model Expense {
  id              String                 @id @default(uuid())
  categoryId      String?
  createdById     String?
  updatedById     String?
  name            String
  description     String?
  amount          Decimal                @db.Decimal(10, 2)
  dueDate         DateTime?
  paidAt          DateTime?
  paymentMethod   PaymentMethod?
  status          ExpenseStatus          @default(PENDING)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  category        ExpenseCategory?       @relation(fields: [categoryId], references: [id])
  createdBy       User?                  @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                  @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  transactions    FinancialTransaction[]
  subscriptionPayout SubscriptionPayout?

  @@index([categoryId])
  @@index([createdById])
  @@index([updatedById])
  @@index([dueDate])
  @@index([paidAt])
  @@index([status])
  @@map("expenses")
}

/// Snapshot de fechamento financeiro por periodo.
/// Nao e recalculado automaticamente quando dados antigos sao ocultados ou restaurados.
model FinancialClosure {
  id              String        @id @default(uuid())
  period          ClosurePeriod @default(WEEKLY)
  startDate       DateTime
  endDate         DateTime
  grossRevenue    Decimal       @default(0.00) @db.Decimal(10, 2)
  expensesTotal   Decimal       @default(0.00) @db.Decimal(10, 2)
  netProfit       Decimal       @default(0.00) @db.Decimal(10, 2)
  barberShare     Decimal       @default(0.00) @db.Decimal(10, 2)
  businessShare   Decimal       @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  closedAt        DateTime?

  @@index([period])
  @@index([startDate])
  @@index([endDate])
  @@map("financial_closures")
}

/// Movimento financeiro realizado.
/// E a fonte de caixa efetivo para receitas/despesas ja confirmadas, respeitando soft delete.
model FinancialTransaction {
  id          String                   @id @default(uuid())
  type        FinancialTransactionType
  amount      Decimal                  @db.Decimal(10, 2)
  description String?
  paymentId   String?
  expenseId   String?
  createdAt   DateTime                 @default(now())
  deletedAt   DateTime?
  expense     Expense?                 @relation(fields: [expenseId], references: [id])
  payment     Payment?                 @relation(fields: [paymentId], references: [id])

  @@index([type])
  @@index([paymentId])
  @@index([expenseId])
  @@map("financial_transactions")
}

/// Comissao individual do barbeiro por atendimento, venda ou lancamento manual.
/// Repasses mensais de assinatura pagos ficam no modelo SubscriptionPayout.
model EmployeeCommission {
  id            String       @id @default(uuid())
  barberId      String
  appointmentId String?
  saleId        String?
  amount        Decimal      @db.Decimal(10, 2)
  percentage    Decimal      @db.Decimal(5, 2)
  paid          Boolean      @default(false)
  createdAt     DateTime     @default(now())
  paidAt        DateTime?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  barber        Barber       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  sale          Sale?        @relation(fields: [saleId], references: [id])

  @@index([barberId])
  @@index([appointmentId])
  @@index([saleId])
  @@map("employee_commissions")
}

/// Atendimento avulso registrado pela equipe fora do fluxo comum de agendamento do cliente.
/// Usa serviceDate como data operacional do atendimento; createdAt e apenas trilha de cadastro.
model ManualService {
  id             String                       @id @default(uuid())
  barberId       String
  clientId       String?
  subscriptionId String?
  createdById    String?
  customerName   String?
  serviceDate    DateTime
  notes          String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  deletedAt      DateTime?
  barber         Barber                       @relation(fields: [barberId], references: [id], onDelete: Cascade)
  client         Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  subscription   Subscription?                @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdBy      User?                        @relation("ManualServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items          ManualServiceItem[]
  changeRequests ManualServiceChangeRequest[]

  @@index([barberId])
  @@index([clientId])
  @@index([subscriptionId])
  @@index([createdById])
  @@index([serviceDate])
  @@index([deletedAt])
  @@map("manual_services")
}

/// Servico dentro de um atendimento avulso.
/// coveredBySubscription separa servico coberto por assinatura de extra cobrado do cliente.
model ManualServiceItem {
  id                    String        @id @default(uuid())
  manualServiceId        String
  serviceId              String
  quantity               Int           @default(1)
  unitPrice              Decimal       @db.Decimal(10, 2)
  chargedUnitPrice       Decimal       @db.Decimal(10, 2)
  duration               Int
  coveredBySubscription  Boolean       @default(false)
  subscriptionPlanName   String?
  createdAt              DateTime      @default(now())
  manualService          ManualService @relation(fields: [manualServiceId], references: [id], onDelete: Cascade)
  service                Service       @relation(fields: [serviceId], references: [id])

  @@index([manualServiceId])
  @@index([serviceId])
  @@index([coveredBySubscription])
  @@map("manual_service_items")
}

/// Pedido de alteracao/exclusao em atendimento avulso quando quem solicita nao tem permissao administrativa.
/// Guarda snapshots para aprovacao segura e eventual restauracao.
model ManualServiceChangeRequest {
  id                String                     @id @default(uuid())
  manualServiceId   String
  requestedById     String?
  decidedById       String?
  type              ManualServiceChangeType
  status            ManualServiceChangeStatus  @default(PENDING)
  previousSnapshot  Json
  proposedSnapshot  Json?
  reason            String?
  createdAt         DateTime                   @default(now())
  decidedAt         DateTime?
  manualService     ManualService              @relation(fields: [manualServiceId], references: [id], onDelete: Cascade)
  requestedBy       User?                      @relation("ManualServiceChangeRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy         User?                      @relation("ManualServiceChangeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([manualServiceId])
  @@index([requestedById])
  @@index([decidedById])
  @@index([status])
  @@index([type])
  @@map("manual_service_change_requests")
}

/// Fechamento mensal do pool de assinaturas para cada barbeiro.
/// Ao ser pago, cria despesa e passa a contar como ganho realizado do profissional.
model SubscriptionPayout {
  id                           String                    @id @default(uuid())
  operationKey                 String?                   @unique
  competenceMonth              String
  barberId                     String
  type                         SubscriptionPayoutType    @default(MAIN)
  adjustmentNumber             Int                       @default(0)
  status                       SubscriptionPayoutStatus  @default(PENDING)
  revenueBase                  Decimal                   @default(0.00) @db.Decimal(10, 2)
  businessShare                Decimal                   @default(0.00) @db.Decimal(10, 2)
  poolAmount                   Decimal                   @default(0.00) @db.Decimal(10, 2)
  totalSubscriberAttendances   Int                       @default(0)
  barberSubscriberAttendances  Int                       @default(0)
  sharePercent                 Decimal                   @default(0.0000) @db.Decimal(8, 4)
  calculatedAmount             Decimal                   @default(0.00) @db.Decimal(10, 2)
  paidAmount                   Decimal                   @default(0.00) @db.Decimal(10, 2)
  paidAt                       DateTime?
  paidById                     String?
  expenseId                    String?                   @unique
  snapshot                     Json
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  barber                       Barber                    @relation(fields: [barberId], references: [id], onDelete: Restrict)
  paidBy                       User?                     @relation("SubscriptionPayoutPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  expense                      Expense?                  @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([competenceMonth, barberId, adjustmentNumber])
  @@index([competenceMonth])
  @@index([barberId])
  @@index([status])
  @@index([paidAt])
  @@index([type])
  @@map("subscription_payouts")
}

/// Faixa semanal de atendimento de um barbeiro.
/// O agendamento publico valida se a duracao total cabe entre inicio e fim.
model BarberAvailability {
  id        String    @id @default(uuid())
  barberId  String
  weekDay   Int
  startTime String
  endTime   String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  barber    Barber    @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, weekDay, startTime])
  @@index([barberId])
  @@index([weekDay])
  @@map("barber_availability")
}

/// Notificacao interna ligada a um usuario.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

/// Endereco salvo para entrega ou cadastro do usuario.
model Address {
  id           String    @id @default(uuid())
  userId       String
  street       String
  number       String
  complement   String?
  neighborhood String?
  city         String
  state        String
  zipCode      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// Chave/valor de configuracao operacional.
model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Avaliacao de cliente para um atendimento finalizado.
model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  clientId      String
  barberId      String
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  barber        Barber      @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([barberId])
  @@index([rating])
  @@map("reviews")
}

/// Trilha de auditoria flexivel para operacoes administrativas e legadas.
/// Alguns registros antigos dependem de metadata para limpeza/restauracao.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  ADMIN
  CLIENT
  BARBER
  EMPLOYEE
  DEVELOPER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  REJECTED
  CANCELED
  EXPIRED
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum ClosurePeriod {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  RETURN
}

enum SaleStatus {
  OPEN
  COMPLETED
  CANCELED
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  COMMISSION
  REFUND
}

enum ManualServiceChangeType {
  UPDATE
  DELETE
}

enum ManualServiceChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPayoutStatus {
  PENDING
  PAID
  REVIEW
}

enum SubscriptionPayoutType {
  MAIN
  ADJUSTMENT
}

enum NotificationType {
  APPOINTMENT
  PAYMENT
  SUBSCRIPTION
  SYSTEM
}
